{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gradeaide.local/schema/requirements.schema.json",
  "title": "GradeAide consolidated requirements registry",
  "description": "Schema for docs/req/requirements.yaml. Every entry is one requirement with a machine-checkable fit criterion.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "type",
      "statement",
      "fit_criterion",
      "priority",
      "source",
      "tradeoff",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^REQ-[A-Z]+-[A-Z0-9]+$"
      },
      "type": {
        "enum": [
          "functional",
          "invariant",
          "quality",
          "performance",
          "cost",
          "governance",
          "security"
        ]
      },
      "statement": {
        "type": "string",
        "minLength": 20
      },
      "fit_criterion": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "threshold", "verification"],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 3
          },
          "threshold": {
            "oneOf": [
              {"type": "number"},
              {"type": "string", "minLength": 1}
            ]
          },
          "verification": {
            "type": "string",
            "minLength": 5
          }
        }
      },
      "priority": {
        "enum": ["Must", "Should", "Could", "Wont"]
      },
      "source": {
        "type": "string",
        "minLength": 5
      },
      "tradeoff": {
        "type": "string",
        "minLength": 5
      },
      "status": {
        "enum": ["proposed", "accepted", "draft", "tbc", "rejected"],
        "default": "proposed"
      },
      "owner": {
        "enum": ["A", "B", "C", "D", "E", "team"]
      },
      "notes": {
        "type": "string"
      }
    }
  }
}
